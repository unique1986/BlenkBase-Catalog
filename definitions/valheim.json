{
  "schemaVersion": 3, "id": "valheim", "displayName": "Valheim Dedicated Server", "summary": "Kooperativer Viking-Survival-Server mit editierbarer Welt- und Zugriffssteuerung.", "maturity": "stable", "tags": ["survival", "coop"],
  "package": { "author": "blnk Base", "version": "1.1.0" },
  "capabilities": ["install", "update", "start", "stop", "configure", "backup", "player-query"], "artwork": { "storeAppId": 892970 },
  "adapters": { "installation": "steamcmd", "lifecycle": "generic-process", "configuration": "catalog-files", "health": "process-and-ports", "population": "steam-a2s", "backup": "persistent-paths", "mods": "none" },
  "installer": { "kind": "steamcmd", "appId": 896660, "anonymous": true },
  "process": {
    "executable": "valheim_server.exe", "workingDirectory": ".", "startupSettingsFile": "blenkbase-startup.json",
    "arguments": ["-nographics", "-batchmode", "-name", "{{setting.ServerName}}", "-port", "{{port.game}}", "-world", "{{setting.WorldName}}", "-password", "{{setting.Password}}", "-savedir", "{{instance.root}}/data", "-public", "{{setting.Public}}", "-saveinterval", "{{setting.SaveInterval}}", "-backups", "{{setting.Backups}}", "-backupshort", "{{setting.BackupShort}}", "-backuplong", "{{setting.BackupLong}}", "-instanceid", "{{setting.InstanceId}}", "{{setting.CrossplayArgument}}"],
    "conditionalArguments": [
      { "setting": "WorldPreset", "omitValues": [""], "arguments": ["-preset", "{{setting.WorldPreset}}"] },
      { "setting": "CombatModifier", "omitValues": [""], "arguments": ["-modifier", "combat", "{{setting.CombatModifier}}"] },
      { "setting": "DeathPenaltyModifier", "omitValues": [""], "arguments": ["-modifier", "deathpenalty", "{{setting.DeathPenaltyModifier}}"] },
      { "setting": "ResourceModifier", "omitValues": [""], "arguments": ["-modifier", "resources", "{{setting.ResourceModifier}}"] },
      { "setting": "RaidModifier", "omitValues": [""], "arguments": ["-modifier", "raids", "{{setting.RaidModifier}}"] },
      { "setting": "PortalModifier", "omitValues": [""], "arguments": ["-modifier", "portals", "{{setting.PortalModifier}}"] },
      { "setting": "NoBuildCostKey", "omitValues": [""], "arguments": ["-setkey", "{{setting.NoBuildCostKey}}"] },
      { "setting": "PlayerEventsKey", "omitValues": [""], "arguments": ["-setkey", "{{setting.PlayerEventsKey}}"] },
      { "setting": "PassiveMobsKey", "omitValues": [""], "arguments": ["-setkey", "{{setting.PassiveMobsKey}}"] },
      { "setting": "NoMapKey", "omitValues": [""], "arguments": ["-setkey", "{{setting.NoMapKey}}"] }
    ],
    "consoleLogFiles": ["data/console.log"], "stopCommand": "shutdown", "stopTimeoutSeconds": 60
  },
  "ports": [{ "key": "game", "protocol": "udp", "preferred": 2456 }, { "key": "query", "protocol": "udp", "preferred": 2457, "offsetFrom": "game", "offset": 1 }],
  "configurationFiles": [{ "path": "blenkbase-startup.json", "label": "Server und Welt", "format": "json", "fields": [
    { "key": "ServerName", "label": "Servername", "group": "Allgemein", "valueType": "string", "defaultValue": "BlenkBase Valheim", "description": "Name im Serverbrowser. Standard: BlenkBase Valheim." },
    { "key": "WorldName", "label": "Weltname", "group": "Welt", "valueType": "string", "defaultValue": "BlenkBase", "description": "Dateiname der Welt. Eine Änderung wählt eine andere Welt. Standard: BlenkBase." },
    { "key": "Password", "label": "Serverkennwort", "group": "Sicherheit", "valueType": "string", "secret": true, "defaultValue": "BitteAendern", "description": "Kennwort zum Beitreten; mindestens fünf Zeichen. Vor öffentlichem Betrieb ändern." },
    { "key": "Public", "label": "Im Serverbrowser anzeigen", "group": "Netzwerk", "valueType": "integer", "defaultValue": "1", "choices": [{ "value": "1", "label": "Ja" }, { "value": "0", "label": "Nein" }], "description": "Listet den Server öffentlich. Standard: Ja." },
    { "key": "CrossplayArgument", "label": "Crossplay", "group": "Netzwerk", "valueType": "string", "defaultValue": "", "choices": [{ "value": "-crossplay", "label": "Ja" }, { "value": "", "label": "Nein – nur Steam" }], "description": "Aktiviert den plattformübergreifenden PlayFab-Netzwerkmodus. Standard: Nein – nur Steam." },
    { "key": "InstanceId", "label": "Eindeutige Serverkennung", "group": "Netzwerk", "valueType": "string", "defaultValue": "1", "description": "Unterscheidet mehrere Valheim-Server auf derselben Maschine im Crossplay-Netz. Bei mehreren Instanzen jeweils eindeutig setzen. Standard: 1." },
    { "key": "WorldPreset", "label": "Welt-Preset", "group": "Weltregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Vorhandene Weltwerte beibehalten" }, { "value": "normal", "label": "Normal" }, { "value": "casual", "label": "Entspannt" }, { "value": "easy", "label": "Einfach" }, { "value": "hard", "label": "Schwer" }, { "value": "hardcore", "label": "Hardcore" }, { "value": "immersive", "label": "Immersiv" }, { "value": "hammer", "label": "Hammermodus" }], "description": "Wendet beim Start ein vollständiges offizielles Welt-Preset an. Ein Preset überschreibt andere Weltmodifikatoren; Standard: vorhandene Weltwerte beibehalten." },
    { "key": "CombatModifier", "label": "Kampfschwierigkeit", "group": "Weltregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nicht überschreiben" }, { "value": "veryeasy", "label": "Sehr einfach" }, { "value": "easy", "label": "Einfach" }, { "value": "hard", "label": "Schwer" }, { "value": "veryhard", "label": "Sehr schwer" }], "description": "Überschreibt nur die Kampfschwierigkeit. Wird nach dem Preset angewendet. Standard: nicht überschreiben." },
    { "key": "DeathPenaltyModifier", "label": "Todesstrafe", "group": "Weltregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nicht überschreiben" }, { "value": "casual", "label": "Entspannt" }, { "value": "veryeasy", "label": "Sehr einfach" }, { "value": "easy", "label": "Einfach" }, { "value": "hard", "label": "Schwer" }, { "value": "hardcore", "label": "Hardcore" }], "description": "Steuert Verlust und Strafen beim Tod. Standard: nicht überschreiben." },
    { "key": "ResourceModifier", "label": "Ressourcenmenge", "group": "Weltregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nicht überschreiben" }, { "value": "muchless", "label": "Viel weniger" }, { "value": "less", "label": "Weniger" }, { "value": "more", "label": "Mehr" }, { "value": "muchmore", "label": "Viel mehr" }, { "value": "most", "label": "Maximum" }], "description": "Ändert die erhaltene Ressourcenmenge. Standard: nicht überschreiben." },
    { "key": "RaidModifier", "label": "Überfallhäufigkeit", "group": "Weltregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nicht überschreiben" }, { "value": "none", "label": "Keine" }, { "value": "muchless", "label": "Viel seltener" }, { "value": "less", "label": "Seltener" }, { "value": "more", "label": "Häufiger" }, { "value": "muchmore", "label": "Viel häufiger" }], "description": "Steuert die Häufigkeit gegnerischer Überfälle. Standard: nicht überschreiben." },
    { "key": "PortalModifier", "label": "Portalregeln", "group": "Weltregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nicht überschreiben" }, { "value": "casual", "label": "Entspannt" }, { "value": "hard", "label": "Schwer" }, { "value": "veryhard", "label": "Sehr schwer" }], "description": "Bestimmt, welche Gegenstände durch Portale transportiert werden dürfen. Standard: nicht überschreiben." },
    { "key": "NoBuildCostKey", "label": "Bauen ohne Materialkosten", "group": "Sonderregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nein" }, { "value": "nobuildcost", "label": "Ja" }], "description": "Aktiviert Bauen und Herstellen ohne Materialkosten. Standard: Nein." },
    { "key": "PlayerEventsKey", "label": "Spielerabhängige Ereignisse", "group": "Sonderregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nein" }, { "value": "playerevents", "label": "Ja" }], "description": "Ereignisse orientieren sich am Fortschritt der anwesenden Spieler. Standard: Nein." },
    { "key": "PassiveMobsKey", "label": "Passive Gegner", "group": "Sonderregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nein" }, { "value": "passivemobs", "label": "Ja" }], "description": "Kreaturen greifen nicht von sich aus an. Standard: Nein." },
    { "key": "NoMapKey", "label": "Karte deaktivieren", "group": "Sonderregeln", "valueType": "string", "defaultValue": "", "choices": [{ "value": "", "label": "Nein" }, { "value": "nomap", "label": "Ja" }], "description": "Deaktiviert die Weltkarte. Standard: Nein." },
    { "key": "SaveInterval", "label": "Speicherintervall", "group": "Spielstand", "valueType": "integer", "defaultValue": "1800", "minimum": 60, "maximum": 7200, "description": "Sekunden zwischen Welt-Sicherungen. Valheim-Standard: 1800." },
    { "key": "Backups", "label": "Anzahl Welt-Backups", "group": "Spielstand", "valueType": "integer", "defaultValue": "4", "minimum": 1, "maximum": 50, "description": "Anzahl automatisch aufbewahrter Welt-Backups. Standard: 4." },
    { "key": "BackupShort", "label": "Kurzes Backup-Intervall", "group": "Spielstand", "valueType": "integer", "defaultValue": "7200", "minimum": 300, "maximum": 86400, "description": "Sekunden zwischen den häufigen Backups. Standard: 7200." },
    { "key": "BackupLong", "label": "Langes Backup-Intervall", "group": "Spielstand", "valueType": "integer", "defaultValue": "43200", "minimum": 3600, "maximum": 604800, "description": "Sekunden zwischen langfristigen Backups. Standard: 43200." }
  ]}],
  "persistentPaths": ["data"], "health": { "processRequired": true, "portKeys": ["game", "query"] }
}
