{
  "schemaVersion": 3,
  "id": "wortwelten",
  "displayName": "Wortex",
  "package": {
    "author": "Blenk",
    "version": "1.0.0",
    "license": "Proprietary"
  },
  "summary": "Stadt, Land, Fluss für Browser, Android und Apple-PWA mit serverautoritärem Online-Multiplayer.",
  "maturity": "experimental",
  "tags": ["party", "multiplayer", "web"],
  "capabilities": ["install", "update", "start", "stop", "configure", "backup"],
  "artwork": {
    "iconUrl": "/artwork/wortwelten-icon.svg",
    "headerUrl": "/artwork/wortwelten.png"
  },
  "adapters": {
    "installation": "github-release",
    "lifecycle": "generic-process",
    "configuration": "catalog-files",
    "health": "process-and-ports",
    "population": "none",
    "backup": "persistent-paths",
    "mods": "none"
  },
  "installer": {
    "kind": "github-release",
    "repository": "unique1986/Wortwelten-Releases",
    "assetPattern": "^Wortwelten-server-windows-x64-.*\\.zip$"
  },
  "process": {
    "executable": "runtime/node.exe",
    "workingDirectory": ".",
    "arguments": [
      "--disable-warning=ExperimentalWarning",
      "server/wortex-server.mjs",
      "--host",
      "0.0.0.0",
      "--port",
      "{{port.game}}",
      "--config",
      "server/blenkbase/wrangler.jsonc",
      "--data",
      "data",
      "--log",
      "data/logs/wortex-server.log"
    ],
    "consoleLogFiles": ["data/logs/wortex-server.log"],
    "stopTimeoutSeconds": 15
  },
  "ports": [
    { "key": "game", "protocol": "tcp", "preferred": 8787 }
  ],
  "configurationFiles": [
    {
      "path": "server/blenkbase/wrangler.jsonc",
      "label": "Antwortprüfung und Push",
      "format": "json",
      "fields": [
        {
          "key": "OLLAMA_ENABLED",
          "jsonPath": "vars.OLLAMA_ENABLED",
          "label": "Ollama-Antwortprüfung",
          "group": "KI-Antwortprüfung",
          "valueType": "boolean",
          "defaultValue": "true",
          "description": "Verwendet Ollama Cloud und die lokale BlenkBase-Ollama-Instanz für unbekannte Antworten."
        },
        {
          "key": "OLLAMA_CLOUD_API_KEY",
          "jsonPath": "vars.OLLAMA_CLOUD_API_KEY",
          "label": "Ollama-Cloud-API-Key",
          "group": "KI-Antwortprüfung",
          "valueType": "string",
          "secret": true,
          "defaultValue": "",
          "description": "Vorhandener Ollama-Cloud-Key. Bleibt ausschließlich auf dem Anwendungsserver."
        },
        {
          "key": "OLLAMA_CLOUD_MODEL",
          "jsonPath": "vars.OLLAMA_CLOUD_MODEL",
          "label": "Ollama-Cloud-Modell",
          "group": "KI-Antwortprüfung",
          "valueType": "string",
          "defaultValue": "gpt-oss:20b",
          "description": "Kostenloses Cloud-Modell für die schnelle Hauptprüfung."
        },
        {
          "key": "OLLAMA_LOCAL_MODEL",
          "jsonPath": "vars.OLLAMA_LOCAL_MODEL",
          "label": "Lokales Ollama-Modell",
          "group": "KI-Antwortprüfung",
          "valueType": "string",
          "defaultValue": "qwen3.5:4b",
          "description": "Bevorzugtes lokales Modell. Ist es nicht installiert, wählt Wortex automatisch ein vorhandenes qwen3.5-Modell."
        },
        {
          "key": "FIREBASE_SERVICE_ACCOUNT_JSON_B64",
          "jsonPath": "vars.FIREBASE_SERVICE_ACCOUNT_JSON_B64",
          "label": "Firebase-Dienstkonto (Base64)",
          "group": "Native Push-Benachrichtigungen",
          "valueType": "string",
          "secret": true,
          "defaultValue": "",
          "description": "Base64-kodierte Firebase-Service-Account-JSON. Bleibt ausschließlich auf dem Anwendungsserver."
        }
      ]
    }
  ],
  "persistentPaths": ["data"],
  "health": {
    "processRequired": true,
    "portKeys": ["game"]
  }
}
