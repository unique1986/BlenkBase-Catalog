{
  "schemaVersion": 3, "id": "no-more-room-in-hell", "displayName": "No More Room in Hell Dedicated Server",
  "package": { "author": "BLNK Labs", "version": "1.0.0", "homepage": "https://wiki.nomoreroominhell.com/Dedicated_Server_Setup" },
  "summary": "Kooperativer Source-Zombieserver mit Karte, Slots, Schwierigkeit, RCON, Download- und Sprachchatoptionen.",
  "maturity": "beta", "tags": ["horror", "coop", "source"], "capabilities": ["install", "update", "start", "stop", "configure", "backup", "player-query"],
  "artwork": { "storeAppId": 224260 }, "adapters": { "installation": "steamcmd", "lifecycle": "stdin-command", "configuration": "catalog-files", "health": "process-and-ports", "population": "steam-a2s", "backup": "persistent-paths", "mods": "none" },
  "installer": { "kind": "steamcmd", "appId": 317670, "anonymous": true, "branch": "public" },
  "process": { "executable": "srcds.exe", "workingDirectory": ".", "startupSettingsFile": "nmrih/cfg/blenkbase-startup.json", "arguments": ["-console", "-game", "nmrih", "-port", "{{port.game}}", "+maxplayers", "{{setting.MaxPlayers}}", "+map", "{{setting.Map}}", "+exec", "server.cfg"], "consoleLogFiles": ["nmrih/logs/*.log"], "stopCommand": "quit", "stopTimeoutSeconds": 30 },
  "ports": [{ "key": "game", "protocol": "udp", "preferred": 27015 }],
  "configurationFiles": [
    { "path": "nmrih/cfg/blenkbase-startup.json", "label": "Karte und Slots", "format": "json", "fields": [
      { "key": "Map", "label": "Startkarte", "group": "Karte", "valueType": "string", "defaultValue": "nmo_broadway", "choices": [{ "value": "nmo_broadway", "label": "Broadway" }, { "value": "nmo_chinatown", "label": "Chinatown" }, { "value": "nmo_lakeside", "label": "Lakeside" }, { "value": "nms_campblood", "label": "Camp Blood Survival" }], "description": "Karte und Modus beim Start. Standard: Broadway." },
      { "key": "MaxPlayers", "label": "Maximale Spieler", "group": "Allgemein", "valueType": "integer", "defaultValue": "8", "minimum": 1, "maximum": 8, "description": "Maximal gleichzeitig verbundene Spieler. Standard und Maximum: 8." }
    ] },
    { "path": "nmrih/cfg/server.cfg", "label": "Servereinstellungen", "format": "source-cfg", "fields": [
      { "key": "hostname", "label": "Servername", "group": "Allgemein", "valueType": "string", "quoted": true, "defaultValue": "blnk - Base NMRiH", "description": "Name im Serverbrowser. Standard: blnk - Base NMRiH." },
      { "key": "sv_password", "label": "Serverkennwort", "group": "Sicherheit", "valueType": "string", "quoted": true, "secret": true, "defaultValue": "", "description": "Optionales Kennwort zum Beitreten. Standard: leer." },
      { "key": "rcon_password", "label": "RCON-Kennwort", "group": "RCON", "valueType": "string", "quoted": true, "secret": true, "defaultValue": "Bitte-Aendern-NMRiH", "description": "Kennwort für RCON. Vor öffentlichem Betrieb ändern." },
      { "key": "sv_lan", "label": "Nur LAN", "group": "Netzwerk", "valueType": "integer", "defaultValue": "0", "choices": [{ "value": "0", "label": "Nein" }, { "value": "1", "label": "Ja" }], "description": "Beschränkt den Server auf LAN. Standard: Nein." },
      { "key": "sv_voiceenable", "label": "Sprachchat", "group": "Kommunikation", "valueType": "integer", "defaultValue": "1", "choices": [{ "value": "1", "label": "Ja" }, { "value": "0", "label": "Nein" }], "description": "Aktiviert Sprachchat. Standard: Ja." },
      { "key": "sv_allowdownload", "label": "Client-Downloads", "group": "Inhalt", "valueType": "integer", "defaultValue": "1", "choices": [{ "value": "1", "label": "Ja" }, { "value": "0", "label": "Nein" }], "description": "Erlaubt Clients fehlende Dateien herunterzuladen. Standard: Ja." }
    ] }
  ],
  "persistentPaths": ["nmrih/cfg", "nmrih/logs", "nmrih/addons"], "health": { "processRequired": true, "portKeys": ["game"] }
}
