{
  "schemaVersion": 3, "id": "black-mesa", "displayName": "Black Mesa Dedicated Server",
  "package": { "author": "BLNK Labs", "version": "1.0.0", "homepage": "https://developer.valvesoftware.com/wiki/Source_Dedicated_Server" },
  "summary": "Source-Dedicated-Server für Black Mesa mit Karte, Slots, LAN/Internet, Kennwort, RCON und Serverlogs.",
  "maturity": "beta", "tags": ["shooter", "source", "multiplayer"], "capabilities": ["install", "update", "start", "stop", "configure", "backup", "player-query"],
  "artwork": { "storeAppId": 362890 }, "adapters": { "installation": "steamcmd", "lifecycle": "stdin-command", "configuration": "catalog-files", "health": "process-and-ports", "population": "steam-a2s", "backup": "persistent-paths", "mods": "none" },
  "installer": { "kind": "steamcmd", "appId": 346680, "anonymous": true, "branch": "public" },
  "process": { "executable": "srcds.exe", "workingDirectory": ".", "startupSettingsFile": "bms/cfg/blenkbase-startup.json", "arguments": ["-console", "-game", "bms", "-port", "{{port.game}}", "+maxplayers", "{{setting.MaxPlayers}}", "+map", "{{setting.Map}}", "+exec", "server.cfg"], "consoleLogFiles": ["bms/logs/*.log"], "stopCommand": "quit", "stopTimeoutSeconds": 30 },
  "ports": [{ "key": "game", "protocol": "udp", "preferred": 27015 }],
  "configurationFiles": [
    { "path": "bms/cfg/blenkbase-startup.json", "label": "Karte und Slots", "format": "json", "fields": [
      { "key": "Map", "label": "Startkarte", "group": "Karte", "valueType": "string", "defaultValue": "dm_crossfire", "description": "Interner Kartenname beim Start. Standard: dm_crossfire." },
      { "key": "MaxPlayers", "label": "Maximale Spieler", "group": "Allgemein", "valueType": "integer", "defaultValue": "16", "minimum": 1, "maximum": 32, "description": "Maximal gleichzeitig verbundene Spieler. Standard: 16." }
    ] },
    { "path": "bms/cfg/server.cfg", "label": "Servereinstellungen", "format": "source-cfg", "fields": [
      { "key": "hostname", "label": "Servername", "group": "Allgemein", "valueType": "string", "quoted": true, "defaultValue": "blnk - Base Black Mesa", "description": "Name im Serverbrowser. Standard: blnk - Base Black Mesa." },
      { "key": "sv_password", "label": "Serverkennwort", "group": "Sicherheit", "valueType": "string", "quoted": true, "secret": true, "defaultValue": "", "description": "Optionales Kennwort zum Beitreten. Standard: leer." },
      { "key": "rcon_password", "label": "RCON-Kennwort", "group": "RCON", "valueType": "string", "quoted": true, "secret": true, "defaultValue": "Bitte-Aendern-BMS", "description": "Kennwort für RCON. Vor öffentlichem Betrieb ändern." },
      { "key": "sv_lan", "label": "Nur LAN", "group": "Netzwerk", "valueType": "integer", "defaultValue": "0", "choices": [{ "value": "0", "label": "Nein" }, { "value": "1", "label": "Ja" }], "description": "Beschränkt den Server auf LAN. Standard: Nein." },
      { "key": "sv_cheats", "label": "Cheats", "group": "Sicherheit", "valueType": "integer", "defaultValue": "0", "choices": [{ "value": "0", "label": "Nein" }, { "value": "1", "label": "Ja" }], "description": "Aktiviert Cheat-CVars. Standard: Nein." },
      { "key": "log", "label": "Serverlogs", "group": "Protokollierung", "valueType": "string", "defaultValue": "on", "choices": [{ "value": "on", "label": "An" }, { "value": "off", "label": "Aus" }], "description": "Aktiviert Source-Serverlogs. Standard: An." }
    ] }
  ],
  "persistentPaths": ["bms/cfg", "bms/logs", "bms/addons"], "health": { "processRequired": true, "portKeys": ["game"] }
}
