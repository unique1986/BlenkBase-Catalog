{
  "schemaVersion": 3, "id": "sven-coop", "displayName": "Sven Co-op Dedicated Server",
  "package": { "author": "BLNK Labs", "version": "1.0.0", "homepage": "https://wiki.svencoop.com/Running_a_server" },
  "summary": "Sven-Co-op-Server mit Karte, Slots, LAN/Internet, Kennwort, RCON, Download- und Friendly-Fire-Optionen.",
  "maturity": "beta", "tags": ["coop", "shooter", "goldsrc"], "capabilities": ["install", "update", "start", "stop", "configure", "backup", "player-query"],
  "artwork": { "storeAppId": 225840 }, "adapters": { "installation": "steamcmd", "lifecycle": "stdin-command", "configuration": "catalog-files", "health": "process-and-ports", "population": "steam-a2s", "backup": "persistent-paths", "mods": "none" },
  "installer": { "kind": "steamcmd", "appId": 276060, "anonymous": true, "branch": "public" },
  "process": { "executable": "svends.exe", "workingDirectory": ".", "startupSettingsFile": "svencoop/blenkbase-startup.json", "arguments": ["-console", "-port", "{{port.game}}", "+maxplayers", "{{setting.MaxPlayers}}", "+map", "{{setting.Map}}", "+exec", "server.cfg"], "consoleLogFiles": ["svencoop/logs/*.log"], "stopCommand": "quit", "stopTimeoutSeconds": 30 },
  "ports": [{ "key": "game", "protocol": "udp", "preferred": 27015 }],
  "configurationFiles": [
    { "path": "svencoop/blenkbase-startup.json", "label": "Karte und Slots", "format": "json", "fields": [
      { "key": "Map", "label": "Startkarte", "group": "Karte", "valueType": "string", "defaultValue": "svencoop1", "description": "Interner Kartenname beim Start. Standard: svencoop1." },
      { "key": "MaxPlayers", "label": "Maximale Spieler", "group": "Allgemein", "valueType": "integer", "defaultValue": "12", "minimum": 1, "maximum": 32, "description": "Maximal gleichzeitig verbundene Spieler. Standard: 12." }
    ] },
    { "path": "svencoop/server.cfg", "label": "Servereinstellungen", "format": "source-cfg", "fields": [
      { "key": "hostname", "label": "Servername", "group": "Allgemein", "valueType": "string", "quoted": true, "defaultValue": "blnk - Base Sven Co-op", "description": "Name im Serverbrowser. Standard: blnk - Base Sven Co-op." },
      { "key": "sv_password", "label": "Serverkennwort", "group": "Sicherheit", "valueType": "string", "quoted": true, "secret": true, "defaultValue": "", "description": "Optionales Kennwort zum Beitreten. Standard: leer." },
      { "key": "rcon_password", "label": "RCON-Kennwort", "group": "RCON", "valueType": "string", "quoted": true, "secret": true, "defaultValue": "Bitte-Aendern-Sven", "description": "Kennwort für RCON. Vor öffentlichem Betrieb ändern." },
      { "key": "sv_lan", "label": "Nur LAN", "group": "Netzwerk", "valueType": "integer", "defaultValue": "0", "choices": [{ "value": "0", "label": "Nein" }, { "value": "1", "label": "Ja" }], "description": "Beschränkt den Server auf LAN. Standard: Nein." },
      { "key": "mp_friendlyfire", "label": "Friendly Fire", "group": "Spielregeln", "valueType": "integer", "defaultValue": "0", "choices": [{ "value": "0", "label": "Nein" }, { "value": "1", "label": "Ja" }], "description": "Erlaubt Schaden an Mitspielern. Standard: Nein." },
      { "key": "sv_allowdownload", "label": "Client-Downloads", "group": "Inhalt", "valueType": "integer", "defaultValue": "1", "choices": [{ "value": "1", "label": "Ja" }, { "value": "0", "label": "Nein" }], "description": "Erlaubt den Download fehlender Serverinhalte. Standard: Ja." }
    ] }
  ],
  "persistentPaths": ["svencoop", "svencoop_addon"], "health": { "processRequired": true, "portKeys": ["game"] }
}
