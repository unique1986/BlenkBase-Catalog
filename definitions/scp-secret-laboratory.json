{
  "schemaVersion": 3, "id": "scp-secret-laboratory", "displayName": "SCP: Secret Laboratory Dedicated Server",
  "package": { "author": "BLNK Labs", "version": "1.0.0", "homepage": "https://en.scpslgame.com/index.php?title=Guide:Hosting_a_server" },
  "summary": "SCP-SL-Server mit LocalAdmin, eigenem Port, Slots, Friendly Fire, Zugangsschutz und instanzgebundenem Konfigurationspfad.",
  "maturity": "experimental", "tags": ["horror", "multiplayer", "shooter"], "capabilities": ["install", "update", "start", "stop", "configure", "backup", "player-query"],
  "artwork": { "storeAppId": 700330 }, "adapters": { "installation": "steamcmd", "lifecycle": "stdin-command", "configuration": "catalog-files", "health": "process-and-ports", "population": "steam-a2s", "backup": "persistent-paths", "mods": "none" },
  "installer": { "kind": "steamcmd", "appId": 996560, "anonymous": true, "branch": "public" },
  "process": { "executable": "LocalAdmin.exe", "workingDirectory": ".", "startupSettingsFile": "blenkbase-startup.json", "arguments": ["{{setting.Port}}"], "consoleLogFiles": ["data/Logs/*.txt"], "stopCommand": "exit", "stopTimeoutSeconds": 45 },
  "ports": [{ "key": "game", "protocol": "udp", "preferred": 7777 }],
  "configurationFiles": [
    { "path": "blenkbase-startup.json", "label": "LocalAdmin-Start", "format": "json", "fields": [{ "key": "Port", "label": "Serverport", "group": "Netzwerk", "valueType": "integer", "portKey": "game", "minimum": 1, "maximum": 65535, "description": "Port, dessen LocalAdmin-Profil gestartet wird. Blenk Base weist ihn automatisch zu." }] },
    { "path": "data/config_gameplay.txt", "label": "Serverregeln", "format": "properties", "fields": [
      { "key": "server_name", "label": "Servername", "group": "Allgemein", "valueType": "string", "defaultValue": "blnk - Base SCP:SL", "description": "Name in der Serverliste. Standard: blnk - Base SCP:SL." },
      { "key": "max_players", "label": "Maximale Spieler", "group": "Allgemein", "valueType": "integer", "defaultValue": "20", "minimum": 2, "maximum": 64, "description": "Maximal gleichzeitig verbundene Spieler. Standard: 20." },
      { "key": "friendly_fire", "label": "Friendly Fire", "group": "Spielregeln", "valueType": "boolean", "defaultValue": "false", "description": "Erlaubt Schaden an Teammitgliedern. Standard: Nein." },
      { "key": "server_password", "label": "Serverkennwort", "group": "Sicherheit", "valueType": "string", "secret": true, "defaultValue": "", "description": "Optionales Kennwort zum Beitreten. Standard: leer." },
      { "key": "contact_email", "label": "Kontaktadresse", "group": "Allgemein", "valueType": "string", "defaultValue": "", "description": "Optionale Kontaktadresse für Moderationsanfragen. Standard: leer." }
    ] }
  ],
  "persistentPaths": ["data", "blenkbase-startup.json"], "health": { "processRequired": true, "portKeys": ["game"] }
}
